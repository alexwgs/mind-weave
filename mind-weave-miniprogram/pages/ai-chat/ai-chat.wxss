.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f3f0;
}

.chat-head {
  padding: 24rpx 28rpx;
  background: linear-gradient(120deg, #6658cc, #8175c7);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-title {
  font-size: 32rpx;
  font-weight: 700;
}

.head-clear {
  font-size: 24rpx;
  opacity: 0.9;
}

.chat-body {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
  height: 0;
}

.chat-empty {
  text-align: center;
  color: #aaa6b2;
  font-size: 24rpx;
  line-height: 2;
  padding-top: 100rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.right {
  justify-content: flex-end;
}

.msg-row.left {
  justify-content: flex-start;
}

.bubble {
  max-width: 80%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

.bubble.mine {
  background: #6658cc;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.bubble.ai {
  background: #fff;
  color: #242437;
  border-bottom-left-radius: 4rpx;
}

.bubble-actions {
  margin-top: 12rpx;
}

.act-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #6658cc;
  background: #efedff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.act-line {
  font-size: 20rpx;
  color: #8f8a98;
  margin-top: 8rpx;
  word-break: break-all;
}

.chat-foot {
  background: #fff;
  padding: 16rpx 20rpx 24rpx;
  border-top: 1rpx solid #f0f1f4;
}

.sugg-row {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.sugg {
  display: inline-block;
  font-size: 22rpx;
  color: #6658cc;
  background: #efedff;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
}

.input-row {
  display: flex;
  gap: 14rpx;
}

.chat-input {
  flex: 1;
  background: #f4f3f0;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #6658cc;
  color: #fff;
  border-radius: 12rpx;
  padding: 0 34rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.send-btn.disabled {
  opacity: 0.6;
}

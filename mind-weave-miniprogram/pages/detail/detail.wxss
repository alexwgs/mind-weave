.head-card {
  background: linear-gradient(135deg, #6658cc 0%, #8579d6 100%);
  color: #ffffff;
}

.head-top {
  display: flex;
  align-items: center;
}

.head-month {
  font-size: 36rpx;
  font-weight: 700;
}

.head-grade {
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

.head-nums {
  display: flex;
  margin-top: 28rpx;
}

.head-num {
  flex: 1;
  text-align: center;
}

.hn-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.hn-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.key-rows {
  padding: 8rpx 24rpx;
}

.key-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f1f4;
}

.key-row:last-child {
  border-bottom: none;
}

.kv {
  font-weight: 600;
}

.kv.strong {
  color: #6658cc;
  font-weight: 700;
}

.g-deduction-row {
  background: #fdeeee;
  border-radius: 10rpx;
  padding: 20rpx 16rpx;
}

.g-extra-row {
  background: #f7f0ff;
  border-radius: 10rpx;
  padding: 20rpx 16rpx;
}

.g-company-row {
  background: #eef6ff;
  border-radius: 10rpx;
  padding: 20rpx 16rpx;
}

.group-card {
  overflow: hidden;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.group-total {
  margin-left: auto;
  margin-right: 12rpx;
  font-weight: 700;
}

.group-body {
  padding-bottom: 12rpx;
}

.field-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid rgba(31, 35, 41, 0.05);
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  color: #6e6977;
}

.field-value {
  font-weight: 600;
}

.comments-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.comment-item {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-field {
  color: #6658cc;
  font-size: 24rpx;
  font-weight: 600;
}

.comment-time {
  color: #aaa6b2;
  font-size: 22rpx;
}

.comment-content {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.comment-author {
  margin-top: 8rpx;
  text-align: right;
  color: #8f8a98;
  font-size: 22rpx;
}

.comment-empty {
  color: #aaa6b2;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.loading-page {
  text-align: center;
  color: #aaa6b2;
  padding-top: 200rpx;
}

.home-page { padding-top: 18rpx; }

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 28rpx;
  color: #f7f5ff;
  background: #242437;
}

.hero::after {
  content: '';
  position: absolute;
  right: -110rpx;
  top: -170rpx;
  width: 350rpx;
  height: 350rpx;
  border: 1rpx solid rgba(184, 172, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 50rpx rgba(184, 172, 255, 0.025), 0 0 0 100rpx rgba(184, 172, 255, 0.015);
}

.hero-meta { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; color: #9e99af; font-family: "DIN Alternate", monospace; font-size: 18rpx; letter-spacing: 1.5rpx; }
.sync { display: flex; align-items: center; gap: 8rpx; }
.sync-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #70b596; box-shadow: 0 0 0 6rpx rgba(112, 181, 150, 0.12); }
.hero-title { position: relative; z-index: 1; margin-top: 38rpx; font-size: 46rpx; font-weight: 750; letter-spacing: -1rpx; }
.hero-sub { position: relative; z-index: 1; margin-top: 13rpx; color: #aaa6ba; font-size: 23rpx; }
.weave-track { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 42rpx; }
.node { width: 12rpx; height: 12rpx; flex: 0 0 auto; border: 2rpx solid #716a8d; border-radius: 50%; background: #242437; }
.node.active { border-color: #b9aeff; background: #b9aeff; box-shadow: 0 0 0 7rpx rgba(185, 174, 255, 0.1); }
.thread { height: 1rpx; flex: 1; background: #48445c; }

.rpg-entry { display: flex; align-items: center; margin-bottom: 22rpx; padding: 24rpx; border: 1rpx solid #e5e1eb; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(36,36,55,.035); }
.level-seal { width: 78rpx; height: 78rpx; flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #6658cc; }
.level-label { font-family: "DIN Alternate", monospace; font-size: 13rpx; letter-spacing: 1rpx; opacity: .72; }
.level-num { font-size: 31rpx; font-weight: 750; line-height: 1; }
.rpg-main { min-width: 0; flex: 1; margin-left: 20rpx; }
.rpg-top { display: flex; align-items: baseline; gap: 13rpx; }
.rpg-kicker { color: #7f74c8; font-family: "DIN Alternate", monospace; font-size: 16rpx; letter-spacing: 1.5rpx; }
.rpg-title { overflow: hidden; color: #29283c; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.rpg-progress { height: 7rpx; margin-top: 14rpx; overflow: hidden; border-radius: 7rpx; background: #eeecf2; }
.rpg-progress view { height: 100%; border-radius: inherit; background: #786bd5; }
.rpg-foot { display: flex; justify-content: space-between; margin-top: 10rpx; color: #9691a1; font-size: 18rpx; }
.rpg-arrow { margin-left: 18rpx; color: #8075c8; font-size: 29rpx; }

.swiper { height: 286rpx; overflow: hidden; margin-bottom: 34rpx; border-radius: 24rpx; }
.swiper-item { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 24rpx; background: #302e44; }
.swiper-img { width: 100%; height: 100%; }
.swiper-ph { box-sizing: border-box; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 17rpx; padding: 36rpx; color: #f7f5ff; background: #302e44; font-size: 33rpx; font-weight: 700; line-height: 1.45; }
.cover-mark { color: #aaa0ea; font-family: "DIN Alternate", monospace; font-size: 17rpx; font-weight: 500; letter-spacing: 2rpx; }
.swiper-mask { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,19,31,.05), rgba(20,19,31,.72)); }
.swiper-title { position: absolute; left: 28rpx; right: 28rpx; bottom: 24rpx; overflow: hidden; color: #fff; font-size: 29rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }

.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 16rpx; }
.section-head > view { display: flex; flex-direction: column; gap: 6rpx; }
.section-kicker { color: #887dc9; font-family: "DIN Alternate", monospace; font-size: 16rpx; letter-spacing: 2rpx; }
.sec-title { color: #262538; font-size: 32rpx; font-weight: 720; }
.sec-more { padding-bottom: 2rpx; color: #777184; font-size: 21rpx; }
.todo-head { margin-top: 34rpx; }

.list-surface { overflow: hidden; border: 1rpx solid #e7e4ec; border-radius: 24rpx; background: #fff; }
.article-row, .todo-row { display: flex; align-items: center; min-height: 104rpx; margin: 0 24rpx; border-bottom: 1rpx solid #efedf2; }
.article-row:last-child, .todo-row:last-child { border-bottom: 0; }
.article-mark { width: 50rpx; height: 50rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 15rpx; color: #7063c8; background: #f0edff; font-size: 22rpx; }
.article-copy, .todo-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 8rpx; margin-left: 18rpx; }
.art-title, .todo-title { overflow: hidden; color: #29283a; font-size: 26rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.art-meta, .todo-meta { overflow: hidden; color: #9994a3; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { margin-left: 14rpx; color: #bbb7c3; font-size: 34rpx; }
.todo-check { width: 32rpx; height: 32rpx; flex: 0 0 auto; border: 2rpx solid #c4bfcd; border-radius: 50%; }
.priority { margin-left: 14rpx; padding: 4rpx 10rpx; border-radius: 8rpx; color: #7f7a88; background: #f1f0f3; font-size: 18rpx; }
.priority.high { color: #ad5b54; background: #fff0ec; }
.priority.mid { color: #9c743d; background: #fff5e5; }

.empty-tip { padding: 34rpx 20rpx; border: 1rpx dashed #dad6e0; border-radius: 20rpx; color: #9994a3; background: rgba(255,255,255,.45); text-align: center; font-size: 22rpx; }
.load-tip { padding: 28rpx 0 50rpx; color: #9994a3; text-align: center; font-size: 22rpx; }

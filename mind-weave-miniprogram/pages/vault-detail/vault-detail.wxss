.head-card {
  background: linear-gradient(135deg, #8175c7 0%, #a78bfa 100%);
  color: #fff;
}

.head-name {
  font-size: 36rpx;
  font-weight: 700;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: none;
}

.r-label {
  width: 180rpx;
  color: #6e6977;
}

.r-value {
  flex: 1;
  font-family: monospace;
  word-break: break-all;
}

.r-copy {
  color: #6658cc;
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  background: #efedff;
  border-radius: 8rpx;
}

.unlock-btn {
  margin-top: 20rpx;
  text-align: center;
  background: #efedff;
  color: #6658cc;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.att {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.att-name {
  flex: 1;
  color: #242437;
}

.att-size {
  color: #aaa6b2;
  font-size: 24rpx;
}

.empty {
  color: #aaa6b2;
  text-align: center;
  padding: 16rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}

.pin-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  z-index: 20;
}

.pin-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.pin-input {
  background: #f4f3f0;
  border-radius: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  text-align: center;
  letter-spacing: 12rpx;
}

.pin-btn {
  margin-top: 24rpx;
  background: #6658cc;
  color: #fff;
  text-align: center;
  border-radius: 12rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

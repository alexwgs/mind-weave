.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8f8a98;
  display: flex;
  gap: 20rpx;
}

.summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f9fb;
  border-radius: 10rpx;
  color: #6e6977;
  font-size: 26rpx;
}

.content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-all;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.video-item {
  background: #f4f3f0;
  border-radius: 10rpx;
  padding: 20rpx;
  color: #6658cc;
  font-size: 26rpx;
}

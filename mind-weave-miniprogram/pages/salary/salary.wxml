<view class="page">
  <view class="card range-card">
    <view class="range-row">
      <picker mode="selector" range="{{yearOptions}}" value="{{yearFromIndex}}" bindchange="onYearFrom">
        <view class="picker">起始年：{{yearFrom}} ▾</view>
      </picker>
      <picker mode="selector" range="{{yearOptions}}" value="{{yearToIndex}}" bindchange="onYearTo">
        <view class="picker">结束年：{{yearTo}} ▾</view>
      </picker>
    </view>
    <view class="quick-row">
      <view class="quick {{quick === 'this' ? 'active' : ''}}" data-v="this" bindtap="onQuick">今年</view>
      <view class="quick {{quick === '3y' ? 'active' : ''}}" data-v="3y" bindtap="onQuick">近3年</view>
      <view class="quick {{quick === 'all' ? 'active' : ''}}" data-v="all" bindtap="onQuick">全部</view>
    </view>
  </view>

  <view class="stat-grid">
    <view class="card stat-card">
      <view class="stat-label">区间实发合计</view>
      <view class="stat-value">{{overview.rangeNetPayText}}</view>
    </view>
    <view class="card stat-card">
      <view class="stat-label">区间总薪资合计</view>
      <view class="stat-value">{{overview.rangeTotalSalaryText}}</view>
    </view>
    <view class="card stat-card">
      <view class="stat-label">区间记录月数</view>
      <view class="stat-value">{{overview.monthCount}}</view>
    </view>
    <view class="card stat-card">
      <view class="stat-label">批注总数</view>
      <view class="stat-value">{{overview.commentCount}}</view>
    </view>
  </view>

  <view class="card chart-card">
    <view class="chart-title">月度总薪资趋势</view>
    <canvas type="2d" id="trendCanvas" class="chart-canvas"></canvas>
  </view>

  <view class="card chart-card">
    <view class="chart-title">年度总薪资对比</view>
    <canvas type="2d" id="annualCanvas" class="chart-canvas"></canvas>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">加载中…</view>
  <view class="ai-fab" bindtap="openAi">AI</view>
</view>

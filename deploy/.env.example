# MindWeave 部署环境变量模板
# 用法：复制为 deploy/.env（已被 .gitignore 忽略），填入真实值后与 docker-compose.yml 一起使用。
# 切勿把填好真实值的 .env 提交到仓库。

# --- 数据库 ---
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- 应用密钥 ---
# JWT 签名密钥，生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# 保险箱凭证加密主密钥，设置后不可再改，否则旧密码无法解密
VAULT_KEY=CHANGE_ME

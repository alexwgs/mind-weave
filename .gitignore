target/
build/
dist/
out/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/
bower_components/

# ---------- 运行期数据 / 上传文件 ----------
mind-weave-backend/uploads/
uploads/
logs/
*.log
*.log.err
*.err.log

